    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/testo.elf",
            "request": "launch",
            "type": "cortex-debug",
            "device": "STM32F446RE",
            // "runToEntryPoint": "main",
            "breakAfterReset": true,
            "servertype": "openocd",
            "serverpath": "C:/OpenOCD/OpenOCD-20250710-0.12.0/bin/openocd.exe",
            "gdbPath": "C:/gcc-arm-none-eabi/arm-gnu-toolchain-14.3.rel1-mingw-w64-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb.exe",
            "configFiles": [
              "interface/stlink.cfg",
              "target/stm32f4x.cfg"
            ],
            "showDevDebugOutput": "raw"
            //MSYS can be integrated https://www.youtube.com/watch?v=-p26X8lTAvo&t=340s
        }
    ]
}

